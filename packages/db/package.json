{
  "name": "@ploutizo/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "migrate": "tsx scripts/migrate.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js}\" && eslint --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@ploutizo/types": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./seeds": "./src/seeds/index.ts",
    "./schema": "./src/schema/index.ts"
  }
}
