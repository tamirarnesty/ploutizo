{
  "name": "@ploutizo/validators",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js}\" && eslint --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ploutizo/types": "workspace:*",
    "@ploutizo/utils": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
