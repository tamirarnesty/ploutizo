{
  "name": "ploutizo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "test -d .git && lefthook install || true",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm --filter @ploutizo/db --silent migrate",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-react-doctor": "^0.9.18",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
