{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "dev:host": "pnpm dev",
    "seed:cloud-environments": "node --import tsx scripts/seed-cloud-environments.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js}\" && eslint --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\""
  },
  "dependencies": {
    "@clerk/hono": "^0.1.93",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@ploutizo/db": "workspace:*",
    "@ploutizo/telemetry": "workspace:*",
    "@ploutizo/types": "workspace:*",
    "@ploutizo/utils": "workspace:*",
    "@ploutizo/validators": "workspace:*",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "neverthrow": "^8.2.0",
    "re2js": "^2.9.0",
    "svix": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "^3.26.2",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
