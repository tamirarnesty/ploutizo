# Copy to apps/api/.env.cloud-environments (gitignored). Do not reuse apps/api/.env —
# that file points at a different Neon branch.
#
# DATABASE_URL must be the Neon **cloud-environments** branch (direct compute host,
# not the -pooler hostname). Clerk keys can be the same instance as local dev.

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.c-5.us-east-1.aws.neon.tech/ploutizo?sslmode=require

CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Dedicated port so this seed does not collide with `pnpm --filter api dev` on 8080.
PORT=18080
APP_ENV=local

# Play URL currently configured in the Clerk dashboard. Used only to warn when
# `svix listen` mints a different relay (Homebrew CLI cannot attach to an existing token).
CLERK_WEBHOOK_RELAY_URL=https://play.svix.com/in/c_DXiiPoSOVJFMDsOp1h5EKOWjg6z/
