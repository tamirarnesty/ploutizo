# apps/api — set these in Railway → api service → Variables (NOT project-level)
# Copy to .env for local development. Never commit .env files.

# Neon direct connection URL (NOT the pooler variant — postgres.js manages its own pool)
# CRITICAL: Never prefix with VITE_ — would embed DB URL in browser bundle
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname

# Clerk secret key
# CRITICAL: Never prefix with VITE_ — would embed secret key in browser bundle
CLERK_SECRET_KEY=sk_live_...

# Clerk publishable key (required by @clerk/hono for JWT verification)
CLERK_PUBLISHABLE_KEY=pk_live_...

# Clerk webhook signing secret (Clerk Dashboard → Configure → Webhooks → Signing secret)
CLERK_WEBHOOK_SECRET=whsec_...

# Port (Railway sets this automatically — only set locally if needed)
PORT=8080

# Optional comma-separated extra browser origins allowed for CORS and Clerk azp checks
# CORS_ALLOWED_ORIGINS=https://preview.example.com

# Deployment environment for telemetry resource attributes (local | preview | production).
# Do not infer from NODE_ENV — set explicitly per environment.
APP_ENV=local

# PostHog project token (phc_...) for OTel traces/logs export. When unset, API
# telemetry stays local (console in APP_ENV=local; no-op exporters otherwise).
# POSTHOG_PROJECT_TOKEN=phc_...
# Optional override; defaults to https://us.i.posthog.com
# POSTHOG_HOST=https://us.i.posthog.com

# Optional release/version resource attribute (falls back to RAILWAY_GIT_COMMIT_SHA)
# APP_RELEASE=1.0.0
# OTEL_SERVICE_NAME=ploutizo-api
